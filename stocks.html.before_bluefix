// ✅ Add robust sentiment extractor
function extractSentiment(s) {
    if (!s || typeof s !== 'object') return null;
    if (s.sentiment && typeof s.sentiment === 'object') s = s.sentiment;
    if (s.sentiment && typeof s.sentiment === 'number') return { bullPct: s.sentiment, bearPct: 100 - s.sentiment };

    const bullPatterns = ['bull', 'green', 'positive', 'up', 'long', 'buy'];
    const bearPatterns = ['bear', 'red', 'negative', 'down', 'short', 'sell'];
    let bullVal = null, bearVal = null;

    for (const key of Object.keys(s)) {
        const lowerKey = key.toLowerCase();
        if (bullVal === null && bullPatterns.some(p => lowerKey.includes(p))) {
            bullVal = Number(s[key]);
            if (isNaN(bullVal)) bullVal = null;
        }
        if (bearVal === null && bearPatterns.some(p => lowerKey.includes(p))) {
            bearVal = Number(s[key]);
            if (isNaN(bearVal)) bearVal = null;
        }
        if (bullVal !== null && bearVal !== null) break;
    }

    if (bullVal === null && bearVal === null) {
        const values = Object.values(s).filter(v => typeof v === 'number' && !isNaN(v));
        if (values.length === 1) {
            const v = values[0];
            if (v >= 0 && v <= 100) { bullVal = v; bearVal = 100 - v; }
        } else if (values.length === 2) {
            const [v1, v2] = values;
            if (v1 >= 0 && v2 >= 0 && Math.abs(v1 + v2 - 100) < 5) {
                bullVal = v1; bearVal = v2;
            }
        }
    }

    if (bullVal !== null && bullVal >= 0 && bullVal <= 1) bullVal *= 100;
    if (bearVal !== null && bearVal >= 0 && bearVal <= 1) bearVal *= 100;

    if (bullVal !== null && bearVal === null) bearVal = Math.max(0, 100 - bullVal);
    else if (bearVal !== null && bullVal === null) bullVal = Math.max(0, 100 - bearVal);

    if (bullVal === null || bearVal === null) return null;
    bullVal = Math.max(0, Math.min(100, Math.round(bullVal)));
    bearVal = Math.max(0, Math.min(100, Math.round(bearVal)));
    if (bullVal === 0 && bearVal === 0) return null;
    return { bullPct: bullVal, bearPct: bearVal };
}

function getColumnValue(pairName, col) {
    const type = COLUMN_TYPES[col.type];
    const t = techMetrics[pairName] || {};
    const s = sentimentData[pairName] || {};
    const m = MARKET_DATA[pairName] || {};
    const lm = liveMarketData[pairName] || {};

    if (col.type === 'tf_alignment') {
        const livePrice = lm.price || lm.currentPrice;
        const ema20_1h = m.ema20 || m['1h_ema20'];
        const sig1h = (livePrice != null && ema20_1h != null) ? (livePrice > ema20_1h ? 'bull' : 'bear') : (m['1h'] || '');
        const ema20_4h = m['4h_ema20'];
        const sig4h = (livePrice != null && ema20_4h != null) ? (livePrice > ema20_4h ? 'bull' : 'bear') : (m['4h'] || '');
        const ema20_1d = m['1day_ema20'];
        const sig1d = (livePrice != null && ema20_1d != null) ? (livePrice > ema20_1d ? 'bull' : 'bear') : (m['1day'] || '');
        const ema20_1w = m['1week_ema20'];
        const sig1w = (livePrice != null && ema20_1w != null) ? (livePrice > ema20_1w ? 'bull' : 'bear') : (m['1week'] || '');
        return [sig1h, sig4h, sig1d, sig1w];
    }
    if (col.type === 'sentiment') {
        return extractSentiment(s);
    }
    if (col.type === 'daily_sentiment') {   // ✅ daily sentiment case
        const bullPct = s.daily_bullish_pct;
        const bearPct = s.daily_bearish_pct;
        if (bullPct == null || bearPct == null) return null;
        const b = Math.round(Number(bullPct));
        const br = Math.round(Number(bearPct));
        if (isNaN(b) || isNaN(br)) return null;
        return { bullPct: b, bearPct: br };
    }
    if (col.type === 'price') return (lm.price || lm.currentPrice || m.price || m.currentPrice || null);
    if (t[type.field] != null) return t[type.field];
    if (m[type.field] != null) return m[type.field];
    return null;
}

function sortValueFor(pairName, col) {
    const v = getColumnValue(pairName, col);
    if (typeof v === 'number') return v;
    if (v && typeof v === 'object' && 'bullPct' in v) return v.bullPct;
    return null;
}

function applyColumnSortAndFilter(list) {
    let out = list;
    columnDefs.forEach(col => {
        if (col.filterMin == null && col.filterMax == null) return;
        out = out.filter(p => {
            const v = sortValueFor(p, col);
            if (v == null) return false;
            if (col.filterMin != null && v < col.filterMin) return false;
            if (col.filterMax != null && v > col.filterMax) return false;
            return true;
        });
    });
    if (sortColumn) {
        const col = columnDefs.find(c => c.id === sortColumn);
        if (col) {
            out = [...out].sort((a,b) => {
                const va = sortValueFor(a, col), vb = sortValueFor(b, col);
                return sortDir === 'desc' ? (vb == null ? -Infinity : vb) - (va == null ? -Infinity : va) : (va == null ? -Infinity : va) - (vb == null ? -Infinity : vb);
            });
        }
    }
    return out;
}

