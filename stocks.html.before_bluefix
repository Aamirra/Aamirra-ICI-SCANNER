    const allSymbols = filteredSymbols.length ? filteredSymbols : Object.keys(MARKET_DATA).sort();
    let filtered = allSymbols;
    const validTargets = new Set(getUniqueAutoSetups().keys());

    if (curF === 'bull' || curF === 'bear') {
        filtered = allSymbols.filter(sym => isStrongTrend(sym, MARKET_DATA[sym], curF));
    } else if (curF === 'target') {
        filtered = allSymbols.filter(sym => validTargets.has(sym));
    }

    filtered = applyColumnSortAndFilter(filtered);
    currentDisplayPairs = filtered.slice();
    chartPairs = filtered.slice();

    renderHeader();

    document.getElementById('pairsContainer').innerHTML = filtered.map(sym => {
        let cells = `<div class="col-pair-fixed"><span style="font-weight:700;font-size:14px;">${sym}</span></div>`;
