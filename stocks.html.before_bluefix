function actualScan() {
    const btn = document.querySelector('.scan-btn');
    const statusEl = document.getElementById('scanStatusText');
    btn.textContent = '⏳ Scanning...';
    btn.disabled = true;
    statusEl.textContent = 'Scan started (may take 2‑3 min)...';
    fetch('/scan').catch(()=>{});
    const ref = db.ref('scanStatus');
    let done = false;
    const listener = ref.on('value', snap => {
        const s = snap.val();
        if (!s) return;
        if (!s.running && !done) {
            done = true;
            ref.off('value', listener);
            btn.textContent = '✅ Done';
            btn.disabled = false;
            db.ref('lastScanTime').set({ time: Date.now() });
            statusEl.textContent = '✅ Scan completed at ' + new Date().toLocaleTimeString();
            setTimeout(() => btn.textContent = 'Scan', 4000);
        } else if (s.running) {
            statusEl.textContent = '🔄 Scanning... (started ' + (s.startedAt ? new Date(s.startedAt).toLocaleTimeString() : '?') + ')';
        }
    });
    setTimeout(() => {
        if (!done) {
            ref.off('value', listener);
            btn.textContent = 'Scan';
            btn.disabled = false;
