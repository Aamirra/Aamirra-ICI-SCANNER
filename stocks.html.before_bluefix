let countdownInterval = null;
function updateCountdown() {
    const intervalStr = chartIntervals[activeChartSlot-1];
    let ms = 0;
    if (intervalStr === 'D') {
        const now = new Date();
        const end = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + 1));
        ms = end - now;
    } else if (intervalStr === 'W') {
        const now = new Date();
        const day = now.getUTCDay();
        const daysUntilMonday = day === 1 ? 7 : (8 - day) % 7;
        const end = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + daysUntilMonday));
        ms = end - now;
    } else {
        const minutes = parseInt(intervalStr) || 60;
        const periodMs = minutes * 60 * 1000;
        ms = periodMs - (Date.now() % periodMs);
    }
    const totalSec = Math.floor(ms / 1000);
    const h = Math.floor(totalSec / 3600);
    const m = Math.floor((totalSec % 3600) / 60);
    const s = totalSec % 60;
    document.getElementById('countdownDisplay').textContent = '⏳ ' + (h>0?`${h}h `:'') + `${m}m ${s}s`;
}
function startCountdownTimer() {
    if (countdownInterval) clearInterval(countdownInterval);
    updateCountdown();
    countdownInterval = setInterval(updateCountdown, 1000);
}

