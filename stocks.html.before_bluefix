}

function getUniqueAutoSetups() {
    const pairMap = new Map();
    if (!stockPbState) return pairMap;
    const validSymbols = new Set(Object.keys(MARKET_DATA));
    const activePhases = ['wait_push', 'wait_dip', 'wait_reclaim', 'alert_triggered'];
    for (const key in stockPbState) {
        const state = stockPbState[key];
        if (!state || !state.dir || !state.phase) continue;
        const parts = key.split('_');
        if (parts.length < 3) continue;
        const dir = parts[parts.length - 1];
        if (dir !== 'bull' && dir !== 'bear') continue;
        const pair = parts.slice(0, parts.length - 2).join('');
        if (!validSymbols.has(pair)) continue;
        if (!activePhases.includes(state.phase)) continue;
        const prio = { 'alert_triggered':4, 'wait_reclaim':3, 'wait_dip':2, 'wait_push':1 };
        const newPrio = prio[state.phase] || 0;
        if (!pairMap.has(pair) || newPrio > (pairMap.get(pair).priority || 0)) {
            pairMap.set(pair, {
                dir: state.dir,
                phase: state.phase,
                priority: newPrio,
                timestamp: state.timestamp || null
            });
        }
    }
    return pairMap;
}

